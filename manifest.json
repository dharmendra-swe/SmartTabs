{
    "manifest_version": 3,
    "name": "SmartTabs",
    "version": "1.0.0",
    "description": "Open Smarter. Work Faster",
    "options_ui": {
        "page": "src/options/index.html",
        "open_in_tab": true
    },
    "action": {
        "default_popup": "src/popup/index.html",
        "default_title": "SmartTabs : "
    },
    "background": {
        "service_worker": "src/background/service-worker.ts",
        "type": "module"
    },
    "permissions": [
        "storage",
        "tabs",
        "alarms",
        "notifications",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "commands": {
        "open-development": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "Launch Development Workspace"
        },
        "open-ai": {
            "suggested_key": {
                "default": "Ctrl+Shift+A",
                "mac": "Command+Shift+A"
            },
            "description": "Launch AI Tools Workspace"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}